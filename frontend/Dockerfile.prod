# =============================================================
# RackView Frontend – Produktions-Image
# Stufe 1 baut das Vue/Vite-Bundle, Stufe 2 liefert es per Nginx
# aus und reicht /api an den Backend-Container weiter.
# Build-Kontext: ./frontend
# =============================================================
FROM node:22-bookworm AS build

WORKDIR /app

# Abhaengigkeiten zuerst – bleibt im Cache, solange sich
# package.json/package-lock.json nicht aendern.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# -------------------------------------------------------------
FROM nginx:1.29-alpine

RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/rackview.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1
