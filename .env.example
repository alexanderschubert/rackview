# =============================================================
# RackView – Vorlage fuer die Datei .env im Projektroot
#   cp .env.example .env   und anschliessend die Werte anpassen
# Diese Datei liegt im Git, die .env selbst niemals.
# =============================================================

# --- Anwendung -----------------------------------------------
APP_NAME=RackView
APP_ENV=local
APP_DEBUG=true
# Leer lassen: der Entrypoint erzeugt beim ersten Start einen
# Schluessel und legt ihn in backend/.env ab. Damit er stabil
# bleibt, den erzeugten Wert hier eintragen.
APP_KEY=
APP_URL=http://localhost:8022

# --- Datenbank -----------------------------------------------
# Achtung: DB_DATABASE/DB_USERNAME/DB_PASSWORD werden nur beim
# ERSTEN Start in ./docker/postgres uebernommen. Spaetere
# Aenderungen erfordern ein Zuruecksetzen des Datenverzeichnisses.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=rackview
DB_USERNAME=rackview
DB_PASSWORD=bitte-eigenes-passwort-setzen

# --- Veroeffentlichte Host-Ports ------------------------------
APP_PORT=8022
DB_HOST_PORT=55432
FRONTEND_PORT=5173
# Oeffentlicher Port des Produktions-Stacks (docker-compose.prod.yml)
PROD_PORT=8080

# --- Konten --------------------------------------------------
# true = auf der Anmeldeseite kann sich jeder ein Konto anlegen.
# Jedes Konto hat einen eigenen, getrennten Workspace. Ist RackView
# aus dem Internet erreichbar, besser auf false setzen.
RACKVIEW_REGISTRATION=true

# --- Anmeldung ueber Authentik (OIDC) -------------------------
# Optional. true schaltet den Knopf "Mit Authentik anmelden" auf der
# Anmeldeseite frei; die Anmeldung mit Passwort bleibt daneben bestehen.
# In Authentik eine OAuth2/OpenID-Application anlegen und dort als
# Redirect URI genau diese Adresse eintragen:
#   https://<adresse-von-rackview>/api/auth/oidc/callback
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.example.de/application/o/rackview/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Mit Authentik anmelden

# --- Verhalten des app-Containers -----------------------------
# true = Migrationen laufen bei jedem Start automatisch
AUTO_MIGRATE=true

# --- Datenbank-Backups ----------------------------------------
# Cron-Ausdruck, Standard: taeglich um 03:00 Uhr
BACKUP_SCHEDULE=0 3 * * *
RETENTION_DAYS=14
BACKUP_DIR=./backups/postgres
# Getrenntes Ziel fuer den Produktions-Stack, damit sich die
# Dumps beider Stacks nicht vermischen
PROD_BACKUP_DIR=./backups/postgres-prod
